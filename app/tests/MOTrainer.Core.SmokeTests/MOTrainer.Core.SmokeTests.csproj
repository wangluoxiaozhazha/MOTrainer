<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MOTrainer.Core.SmokeTests</RootNamespace>
    <AssemblyName>MOTrainer.Core.SmokeTests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MOTrainer.Core\MOTrainer.Core.csproj" />
    <Compile Include="..\..\src\MOTrainer.WinForms\HotkeyGesture.cs"
             Link="WinForms\HotkeyGesture.cs" />
    <Compile Include="..\..\src\MOTrainer.WinForms\HotkeyBindings.cs"
             Link="WinForms\HotkeyBindings.cs" />
    <Compile Include="..\..\src\MOTrainer.WinForms\TrainerSettings.cs"
             Link="WinForms\TrainerSettings.cs" />
    <Compile Include="..\..\src\MOTrainer.WinForms\SuperweaponChoices.cs"
             Link="WinForms\SuperweaponChoices.cs" />
    <Compile Include="..\..\src\MOTrainer.WinForms\Localization\UiStrings.cs"
             Link="WinForms\Localization\UiStrings.cs" />
    <EmbeddedResource Include="..\..\src\MOTrainer.WinForms\Resources\UiStrings.resx"
                      Link="WinForms\Resources\UiStrings.resx">
      <LogicalName>MOTrainer.WinForms.Resources.UiStrings.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
