<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="settings.version" value="2" />
    <add key="ui.language" value="Auto" />
    <add key="unit.modifyVeterancy" value="True" />
    <add key="unit.veterancy" value="Elite" />
    <add key="unit.modifyHealth" value="False" />
    <add key="unit.health" value="10000000" />
    <add key="unit.autoEditMode" value="Event" />
    <add key="faction.money" value="123456" />
    <add key="faction.autoApplyMoney" value="False" />
    <add key="techUnlock.mode" value="Faction" />
    <add key="superweapon.selectedIds" value="" />
    <add key="hotkey.faction.defeat-owner" value="Ctrl+Space" />
    <add key="hotkey.faction.zero-economy" value="Ctrl+O" />
    <add key="hotkey.patch.auto-repair" value="Ctrl+T" />
    <add key="hotkey.patch.control-all-units" value="Ctrl+I" />
    <add key="hotkey.patch.economy-no-decrease" value="Ctrl+Q" />
    <add key="hotkey.patch.ignore-build-distance" value="Ctrl+R" />
    <add key="hotkey.patch.ignore-cloak" value="Ctrl+U" />
    <add key="hotkey.patch.instant-unit-build" value="Ctrl+E" />
    <add key="hotkey.patch.power-no-decrease" value="Ctrl+W" />
    <add key="hotkey.patch.psychic-detection" value="Ctrl+Y" />
    <add key="hotkey.patch.safe-tech-unlock" value="Ctrl+P" />
    <add key="hotkey.patch.stable-reveal-map" value="Ctrl+H" />
    <add key="hotkey.superweapon.grant-selected" value="Ctrl+G" />
    <add key="hotkey.unit.add-health" value="Ctrl+S" />
    <add key="hotkey.unit.auto-edit" value="Ctrl+A" />
    <add key="hotkey.unit.set-one-health" value="Ctrl+D" />
    <add key="hotkey.unit.transfer-owner" value="Ctrl+F" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
